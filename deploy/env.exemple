# Secrets et réglages de l'API de l'atelier.
#
#   cp deploy/env.exemple .env      puis remplir, puis  chmod 600 .env
#
# Le site public n'en a PAS besoin : il est statique, sans backend et sans clé.
# Ce fichier ne concerne que l'atelier. `.env` est ignoré par git — il doit le
# rester.

# ── Obligatoires si l'atelier tourne ─────────────────────────────────────────

# Signature des jetons de session. Sans lui, l'API répond 503 sur toute
# authentification : elle refuse plutôt que de signer avec une clé vide.
#   openssl rand -hex 32
JWT_SECRET=

# Clé de service, pour les scripts qui appellent l'API sans session humaine.
# Elle contourne le verrou JWT : la traiter comme un mot de passe root.
# Laisser VIDE si aucun script n'en a besoin — une clé absente ne donne aucun accès.
#   openssl rand -hex 24
ADMIN_KEY=

# Origines autorisées à appeler l'API depuis un navigateur, séparées par des
# virgules. Sans cette variable, seuls les ports de développement local sont
# acceptés — donc l'atelier en ligne ne fonctionne pas tant qu'on ne la remplit
# pas. C'est voulu : mieux vaut une page cassée qu'une API ouverte à tous.
ALLOWED_ORIGINS=https://atelier.example.org

# ── Facultatifs ──────────────────────────────────────────────────────────────

# Recherche par sens dans l'atelier (embeddings locaux via Ollama). À 0 — le
# défaut — les routes /api/rag/* sont inertes et l'interface le dit. À activer
# sur la machine qui porte Ollama, pas sur un serveur qui ne l'a pas.
# L'index se construit avec : python3 scripts/build_rag_index.py
RAG_ENABLED=0

# Ollama : adresse et modèles. L'interface affiche ce qui est réglé ici.
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=gemma3:4b

# Synthèse par modèle de langage (/api/synthesize). Le fournisseur est libre :
# le moteur n'en impose aucun et n'installe aucune bibliothèque propre à l'un
# d'eux. Sans IA_URL ni IA_MODELE, la fonction est simplement absente — le
# reste de l'atelier n'en dépend pas.
#
# IA_PROTOCOLE=openai désigne un FORMAT de requête, pas une entreprise : c'est
# celui que parlent Ollama, llama.cpp, vLLM, LM Studio, Groq, Mistral, DeepSeek,
# OpenAI et les passerelles type OpenRouter. Mettre « anthropic » pour l'API
# d'Anthropic, qui est la seule répandue à ne pas suivre ce format.
#
#   local (Ollama, rien ne sort de la machine, aucune clé) :
#     IA_URL=http://localhost:11434/v1
#     IA_MODELE=gemma3:4b
#   distant, au choix, par exemple :
#     IA_URL=https://api.groq.com/openai/v1        IA_MODELE=llama-3.3-70b-versatile
#     IA_URL=https://api.mistral.ai/v1             IA_MODELE=mistral-large-latest
#     IA_URL=https://api.anthropic.com/v1          IA_PROTOCOLE=anthropic
IA_URL=
IA_MODELE=
IA_CLE=

# Taille des tranches de texte envoyées au modèle, en caractères. Par défaut
# 10 000 (~3 000 tokens), taillé pour une fenêtre de contexte de 8 192 tokens —
# celle qu'Ollama applique PAR DÉFAUT, quelle que soit la fenêtre annoncée du
# modèle.
#
# Mesuré au banc d'essai le 21/08/2026 : avec des tranches de 24 000 caractères,
# le contexte débordait, Ollama tronquait sans rien dire, et la consigne sautait
# la première. qwen2.5:14b ne trouvait plus rien dans un PV de 45 000 caractères
# et gemma4:26b ne rendait plus de JSON du tout — deux modèles muets sans une
# seule erreur affichée.
#
# À augmenter seulement si le serveur sert vraiment une fenêtre plus grande
# (Ollama : `num_ctx` dans le Modelfile ou OLLAMA_CONTEXT_LENGTH).
IA_TAILLE_TRANCHE=
IA_PROTOCOLE=openai

# API payante d'enrichissement d'entreprises (collectors/pappers.py). Le
# collecteur ne se déclenche jamais tout seul ; sans jeton il ne fait rien.
PAPPERS_API_TOKEN=
