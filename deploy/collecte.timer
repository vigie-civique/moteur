# systemd — quand passe la collecte (deploy/collecte.service).
#
# Une fois par jour, la nuit. `Persistent` : une machine éteinte à l'heure dite
# rattrape la passe au démarrage — le défaut d'un rendez-vous qui suppose une
# machine allumée, déjà rencontré sur un poste de travail.

[Unit]
Description=Vigie Civique — passe de collecte quotidienne

[Timer]
OnCalendar=*-*-* 03:30:00 UTC
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
